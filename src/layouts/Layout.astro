---
import PantallaLogin from '../components/PantallaLogin.astro';
import PantallaCategorias from '../components/PantallaCategorias.astro';
import PantallaMujer from '../components/PantallaMujer.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clothing Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,600;0,700;1,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

<PantallaLogin />
<PantallaCategorias />
<PantallaMujer />

<script>
    document.getElementById("formLogin")!.addEventListener("submit", function(e){
        e.preventDefault();
        cambiarPantalla("pantalla-categorias");
    });

    document.getElementById("googleBtn")!.addEventListener("click", function(){
        cambiarPantalla("pantalla-categorias");
    });

    document.getElementById("btnMujer")!.addEventListener("click", function(){
        cambiarPantalla("pantalla-mujer");
    });

    function cambiarPantalla(id: string){
        document.querySelectorAll(".pantalla").forEach(p => p.classList.remove("activa"));
        document.getElementById(id)!.classList.add("activa");
    }
</script>

</body>
</html>
