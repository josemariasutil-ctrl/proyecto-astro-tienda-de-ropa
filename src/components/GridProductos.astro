---
import Producto from './Producto.astro';

const productos = [
    { nombre: 'Abrigo largo pliegue espalda', precio: '59,99 €' },
    { nombre: 'Abrigo largo pliegue pecho', precio: '59,99 €' },
    { nombre: 'Abrigo acolchado extralargo', precio: '49,99 €' },
    { nombre: 'Gabardina vaquera', precio: '69,99 €' },
    { nombre: 'Abrigo paño', precio: '29,99 €' },
    { nombre: 'Abrigo acolchado capucha', precio: '49,99 €' },
    { nombre: 'Abrigo borreguillo', precio: '19,99 €' },
    { nombre: 'Jeans skinny rotos', precio: '9,99 €' },
];
---

<div class="grid-productos">
    {productos.map((p) => (
        <Producto nombre={p.nombre} precio={p.precio} />
    ))}
</div>
