---
import HeaderMujer from './HeaderMujer.astro';
import BannerTexto from './BannerTexto.astro';
import BarraProductos from './BarraProductos.astro';
import GridProductos from './GridProductos.astro';
---

<div id="pantalla-mujer" class="pantalla">

    <div class="banner-mujer">
        <img src="/cabecera.png" alt="Banner">
        <HeaderMujer />
        <BannerTexto />
    </div>

    <div class="productos">
        <BarraProductos />
        <GridProductos />
    </div>

</div>
